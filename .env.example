# Copy to .env and adjust. All vars are prefixed FIPM_ and read by pydantic-settings.
FIPM_BASE_URL=http://localhost:8000
FIPM_DB_PATH=./fipm.db
FIPM_SECRET_KEY=change-me-to-a-long-random-value
FIPM_ID_PREFIX=
FIPM_ADMIN_EMAIL=
FIPM_ADMIN_PASSWORD=
FIPM_DEFAULT_LANGUAGE=en
FIPM_DATA_DIR=./data
# FIPM_STATIC_DIR defaults to <repo>/frontend/dist; the Docker image sets /app/static
#FIPM_STATIC_DIR=./frontend/dist
FIPM_SESSION_TTL_DAYS=14
FIPM_COOKIE_SECURE=true
FIPM_ALLOWED_ORIGINS=
FIPM_REGISTRATION_OPEN=true
# spec 09-standalone-fips.md: whether an anonymous caller with no session and
# no account may create a FIP at all (POST /fips with neither sessionId nor
# a signed-in cookie). Session participants and signed-in users are
# unaffected either way.
FIPM_ANONYMOUS_FIPS=true
FIPM_ENV=development
# Shown in the privacy notice ({{CONTACT_EMAIL}}/{{HOSTING_ORG}}) and by
# GET /api/health -- set these to your real deployment before going live.
FIPM_CONTACT_EMAIL=contact@example.org
FIPM_HOSTING_ORG=the FIP Manager operators
# Only set to true when a trusted reverse proxy sits in front of this
# deployment and is known to set (and strip any client-supplied copy of)
# X-Forwarded-For -- otherwise a client can spoof its own IP and dodge the
# feedback rate limit. Leave false for a direct/no-proxy deployment.
FIPM_TRUST_PROXY=false
# spec 11-nanopub-network.md §3.4: the read-only nanopublication-network
# proxy (GET /api/network/*). false hides the Network FIPs nav entry and
# 503s all three endpoints.
FIPM_NETWORK_ENABLED=true
# Scheme + host only, no trailing slash -- https://query.petapico.org is a
# verified drop-in mirror. Validated at startup (check_network_safety):
# https only, a hostname, no userinfo, no path.
FIPM_NANOPUB_QUERY_URL=https://query.knowledgepixels.com
# Per-upstream-request timeout in seconds (httpx.Timeout(this, connect=5.0)).
FIPM_NETWORK_TIMEOUT_SECONDS=10.0
# How long a cached network response (communities/FIP-detail/FER-search) is
# served before a fresh upstream call is made.
FIPM_NETWORK_CACHE_TTL_SECONDS=900
# Upstream response bytes above which a call is aborted with 502
# network_response_too_large (the network's own unfiltered queries can
# return 10+ MB).
FIPM_NETWORK_MAX_RESPONSE_BYTES=8388608
