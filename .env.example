# Copy to .env and adjust. All vars are prefixed FIPM_ and read by pydantic-settings.
FIPM_BASE_URL=http://localhost:8000
FIPM_DB_PATH=./fipm.db
FIPM_SECRET_KEY=change-me-to-a-long-random-value
FIPM_ID_PREFIX=
FIPM_ADMIN_EMAIL=
FIPM_ADMIN_PASSWORD=
FIPM_DEFAULT_LANGUAGE=en
FIPM_DATA_DIR=./data
# FIPM_STATIC_DIR defaults to <repo>/frontend/dist; the Docker image sets /app/static
#FIPM_STATIC_DIR=./frontend/dist
FIPM_SESSION_TTL_DAYS=14
FIPM_COOKIE_SECURE=true
FIPM_ALLOWED_ORIGINS=
FIPM_REGISTRATION_OPEN=true
# spec 09-standalone-fips.md: whether an anonymous caller with no session and
# no account may create a FIP at all (POST /fips with neither sessionId nor
# a signed-in cookie). Session participants and signed-in users are
# unaffected either way.
FIPM_ANONYMOUS_FIPS=true
FIPM_ENV=development
# Shown in the privacy notice ({{CONTACT_EMAIL}}/{{HOSTING_ORG}}) and by
# GET /api/health -- set these to your real deployment before going live.
FIPM_CONTACT_EMAIL=contact@example.org
FIPM_HOSTING_ORG=the FIP Manager operators
# Only set to true when a trusted reverse proxy sits in front of this
# deployment and is known to set (and strip any client-supplied copy of)
# X-Forwarded-For -- otherwise a client can spoof its own IP and dodge the
# feedback rate limit. Leave false for a direct/no-proxy deployment.
FIPM_TRUST_PROXY=false
# spec 11-nanopub-network.md §3.4: the read-only nanopublication-network
# proxy (GET /api/network/*). false hides the Network FIPs nav entry and
# 503s all three endpoints.
FIPM_NETWORK_ENABLED=true
# Scheme + host only, no trailing slash -- https://query.petapico.org is a
# verified drop-in mirror. Validated at startup (check_network_safety):
# https only, a hostname, no userinfo, no path.
FIPM_NANOPUB_QUERY_URL=https://query.knowledgepixels.com
# Per-upstream-request timeout in seconds (httpx.Timeout(this, connect=5.0)).
FIPM_NETWORK_TIMEOUT_SECONDS=10.0
# How long a cached network response (communities/FIP-detail/FER-search) is
# served before a fresh upstream call is made.
FIPM_NETWORK_CACHE_TTL_SECONDS=900
# Upstream response bytes above which a call is aborted with 502
# network_response_too_large (the network's own unfiltered queries can
# return 10+ MB).
FIPM_NETWORK_MAX_RESPONSE_BYTES=8388608
# spec 13-fip-dashboard.md §7.5: the five-view scale-aware dashboard. false
# 503s all /api/dashboard/* endpoints, hides the nav entry, and makes the
# projection write hook a no-op (a genuine kill switch for the write-path
# cost, not just a UI toggle).
FIPM_DASHBOARD_ENABLED=true
# k-anonymity floor (§2.4): a population below this many FIPs 403s
# population_too_small only if it also contains a FIP the viewer could not
# read individually -- the facilitator's own small session never binds.
FIPM_DASHBOARD_MIN_POPULATION=5
# T1 "live" ceiling in fip_cells rows (~12k FIPs on the GO FAIR 21-question
# model); above it a view needs the snapshot layer (brief B).
FIPM_DASHBOARD_LIVE_MAX_CELLS=250000
# Above this estimated cost, POST /dashboard/refresh runs in the background
# (202) instead of synchronously; must be >= FIPM_DASHBOARD_LIVE_MAX_CELLS.
FIPM_DASHBOARD_SYNC_MAX_CELLS=600000
# §1.8 degrade ladder: at or below this many FIPs, a stale/missing
# projection is recomputed on the fly in Python instead of refusing.
FIPM_DASHBOARD_FALLBACK_MAX_FIPS=200
# How long a dashboard_snapshots row is served before recomputation (brief B).
FIPM_DASHBOARD_SNAPSHOT_TTL_SECONDS=3600
FIPM_DASHBOARD_SNAPSHOT_MAX_BYTES=4194304
# Row cap for GET /api/dashboard/{view}.csv (a trailing "# truncated" line
# marks a capped export).
FIPM_DASHBOARD_CSV_MAX_ROWS=100000
# §7.2: backfill the projection inline at startup when <= the cap below;
# above it, log a WARNING and leave it to `python -m fipm
# backfill-declarations --only-stale` (the workshop laptop never needs this
# at ~40 FIPs).
FIPM_DASHBOARD_BACKFILL_ON_STARTUP=true
FIPM_DASHBOARD_STARTUP_BACKFILL_MAX_FIPS=500
# §4.3 similarity candidate generation (brief B): total posting rows
# scanned per neighbours request, per-key cap, and how many candidates get
# exactly rescored.
FIPM_DASHBOARD_POSTING_BUDGET=20000
FIPM_DASHBOARD_POSTING_CAP=2000
FIPM_DASHBOARD_CANDIDATE_CAP=200
# A key held by more than this share of the population is skipped as
# uninformative (e.g. DOI/ORCID), unless fewer than DF_MIN_KEYS remain.
FIPM_DASHBOARD_DF_SKIP_SHARE=0.20
FIPM_DASHBOARD_DF_MIN_KEYS=3
# §4.2 MinHash/LSH parameters (brief B); BANDS * ROWS must equal K, checked
# by check_dashboard_safety() at startup.
FIPM_DASHBOARD_LSH_K=128
FIPM_DASHBOARD_LSH_BANDS=32
FIPM_DASHBOARD_LSH_ROWS=4
FIPM_DASHBOARD_LSH_SEED=20260911
FIPM_DASHBOARD_LSH_BUCKET_MAX=500
FIPM_DASHBOARD_LSH_PAIR_CAP=200000
# Below this population size, similarity clustering/the map are computed
# exactly over all pairs instead of via LSH candidates.
FIPM_DASHBOARD_EXACT_PAIRS_MAX_FIPS=300
# The per-FIP similarity scatter is offered only at or below this size.
FIPM_DASHBOARD_LIVE_MAX_FIPS_SCATTER=300
FIPM_DASHBOARD_CLUSTER_MIN_SIM=0.6
# §4.1: how the 12 FAIR principle codes are weighted in the similarity
# score -- "principle" (equal per code, the default), "question", or "letter".
FIPM_DASHBOARD_DEFAULT_WEIGHTING=principle
# §11.3 amendment: cap on the similarity map's scatter `edges` (thresholded
# at CLUSTER_MIN_SIM, ordered by similarity) -- an unbounded edge list
# scales with the population, which the map's whole design avoids elsewhere.
FIPM_DASHBOARD_MAP_EDGE_CAP=5000
